ght="38" as="geometry"/></mxCell><mxCell id="s4-68" value="" style="endArrow=block;endFill=1;html=1;rounded=1;strokeWidth=1.5;strokeColor=#2980b9;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s4-39" target="s4-67"><mxGeometry x="-0.62" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s4-69" value="RENTAL.&lt;br&gt;RentalNo" style="rounded=0;html=1;dashed=1;fillColor=none;fontSize=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="192" y="2221" width="108" height="38" as="geometry"/></mxCell><mxCell id="s4-70" value="" style="endArrow=block;endFill=1;html=1;rounded=1;strokeWidth=1.5;strokeColor=#27ae60;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s4-47" target="s4-69"><mxGeometry x="-0.62" relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="qa" name="3-Questions-Assumptions"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1852" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="qa-141" value="Omar Salem  |  Group: &amp;lt;GROUP&amp;gt;  |  Student ID: &amp;lt;STUDENT_ID&amp;gt;   |   Page: 3-Questions-Assumptions" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="1400" height="30" as="geometry"/></mxCell><mxCell id="qa-2" value="&lt;b&gt;Part C.1 - Questions raised from the SRS&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="1540" height="34" as="geometry"/></mxCell><mxCell id="qa-3" value="&lt;b&gt;#&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="60" height="30" as="geometry"/></mxCell><mxCell id="qa-4" value="&lt;b&gt;Question&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="160" width="760" height="30" as="geometry"/></mxCell><mxCell id="qa-5" value="&lt;b&gt;SRS section&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="160" width="120" height="30" as="geometry"/></mxCell><mxCell id="qa-6" value="&lt;b&gt;Working answer in this design&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="160" width="600" height="30" as="geometry"/></mxCell><mxCell id="qa-7" value="Q1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-8" value="Senior management 'reports to nobody' and a regional director covers a branch temporarily. Are these employees assigned to a branch like everyone else, and do they appear in the branch-manager relationship?" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="190" width="760" height="46" as="geometry"/></mxCell><mxCell id="qa-9" value="7.1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="190" width="120" height="46" as="geometry"/></mxCell><mxCell id="qa-10" value="Treated as employees of a head-office branch row (see A1). Temporary cover is not modelled as MANAGES." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="190" width="600" height="46" as="geometry"/></mxCell><mxCell id="qa-11" value="Q2" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="236" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-12" value="When a luxury vehicle has its own daily rate AND its category has a rate AND the corporate customer has a category discount, which price wins, and is the discount applied to the vehicle-level rate?" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="236" width="760" height="46" as="geometry"/></mxCell><mxCell id="qa-13" value="7.3, 7.8" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="236" width="120" height="46" as="geometry"/></mxCell><mxCell id="qa-14" value="Assumed: vehicle rate overrides category rate for the date; discount % applies to whichever base rate was used (see A4)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="236" width="600" height="46" as="geometry"/></mxCell><mxCell id="qa-15" value="Q3" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="282" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-16" value="May a corporate customer have several discounts for the same category with overlapping dates? Is 50% the cap per row or the combined cap? Can a promo code stack with a corporate discount?" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="282" width="760" height="46" as="geometry"/></mxCell><mxCell id="qa-17" value="7.8, 7.9" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="282" width="120" height="46" as="geometry"/></mxCell><mxCell id="qa-18" value="Assumed no overlap per (customer, category), 50% per row, promo stacking decided by application (BR-3)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="282" width="600" height="46" as="geometry"/></mxCell><mxCell id="qa-19" value="Q4" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="328" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-20" value="Are loyalty tiers based on the current points balance or on lifetime earned points? Do points expire? Is the tier stored or derived?" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="328" width="760" height="46" as="geometry"/></mxCell><mxCell id="qa-21" value="7.10" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="328" width="120" height="46" as="geometry"/></mxCell><mxCell id="qa-22" value="Assumed derived from the current balance (SUM of POINTS_LOG), nothing stored (A8)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="328" width="600" height="46" as="geometry"/></mxCell><mxCell id="qa-23" value="Q5" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="374" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-24" value="Can an extension change the vehicle, and is the number of extensions in a chain limited? Does each extension need its own insurance/extras/payments?" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="374" width="760" height="46" as="geometry"/></mxCell><mxCell id="qa-25" value="7.12" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="374" width="120" height="46" as="geometry"/></mxCell><mxCell id="qa-26" value="Assumed same customer and vehicle; unlimited chain; each extension is an ordinary rental row (BR-6)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="374" width="600" height="46" as="geometry"/></mxCell><mxCell id="qa-27" value="Q6" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-28" value="Objective O-1 asks for 100% vehicle location accuracy, but only branch transfers and a GPS device (no coordinates) are described. Must GPS positions be stored?" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="420" width="760" height="46" as="geometry"/></mxCell><mxCell id="qa-29" value="5 (O-1), 7.5, 7.6" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="420" width="120" height="46" as="geometry"/></mxCell><mxCell id="qa-30" value="Out of scope for this schema: location = CURRENT branch + transfer log. A GPS_READING table is a possible extension." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="420" width="600" height="46" as="geometry"/></mxCell><mxCell id="qa-31" value="Q7" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="466" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-32" value="Damage report has an estimated repair cost; which table records the final amount charged to the customer? Can one damage report lead to several job cards?" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="466" width="760" height="46" as="geometry"/></mxCell><mxCell id="qa-33" value="7.14, 7.15, 7.16" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="466" width="120" height="46" as="geometry"/></mxCell><mxCell id="qa-34" value="Assumed charged through PAYMENT (type Damage); the SRS says 1:1 optional with job card, so one." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="466" width="600" height="46" as="geometry"/></mxCell><mxCell id="qa-35" value="Q8" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="512" width="60" height="30" as="geometry"/></mxCell><mxCell id="qa-36" value="How are monthly corporate invoices linked to rentals and payments (due date, status, which rentals)?" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="512" width="760" height="30" as="geometry"/></mxCell><mxCell id="qa-37" value="7.16" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="512" width="120" height="30" as="geometry"/></mxCell><mxCell id="qa-38" value="Added INVOICE (invoice per corporate customer per month) and RENTAL.InvoiceNo (A12)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="512" width="600" height="30" as="geometry"/></mxCell><mxCell id="qa-39" value="Q9" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="542" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-40" value="What is the pass mark for a training attempt, and is Pass/Fail stored or derived from Score?" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="542" width="760" height="46" as="geometry"/></mxCell><mxCell id="qa-41" value="7.2" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="542" width="120" height="46" as="geometry"/></mxCell><mxCell id="qa-42" value="Stored as given (SRS lists pass/fail as tracked data); the pass mark is left to the application." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="542" width="600" height="46" as="geometry"/></mxCell><mxCell id="qa-43" value="Q10" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="588" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-44" value="Can a customer be blacklisted more than once or removed from the blacklist? Can any employee blacklist, or only branch managers?" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="588" width="760" height="46" as="geometry"/></mxCell><mxCell id="qa-45" value="7.7" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="588" width="120" height="46" as="geometry"/></mxCell><mxCell id="qa-46" value="Assumed several records allowed with an IsActive flag; BlacklistedByID must be an employee (manager role checked in BR-1/application)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="588" width="600" height="46" as="geometry"/></mxCell><mxCell id="qa-47" value="Q11" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="634" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-48" value="Can one reservation lead to more than one rental (e.g. vehicle swap), and what happens to the vehicle if a reservation is a no-show?" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="634" width="760" height="46" as="geometry"/></mxCell><mxCell id="qa-49" value="7.11, 7.12" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="634" width="120" height="46" as="geometry"/></mxCell><mxCell id="qa-50" value="SRS says optional 1:1, so UQ on RENTAL.ReservationNo." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="634" width="600" height="46" as="geometry"/></mxCell><mxCell id="qa-51" value="&lt;b&gt;Part C.2 - Design assumptions (not stated in the SRS)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="730" width="1540" height="34" as="geometry"/></mxCell><mxCell id="qa-52" value="&lt;b&gt;#&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="60" height="30" as="geometry"/></mxCell><mxCell id="qa-53" value="&lt;b&gt;Assumption&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="770" width="880" height="30" as="geometry"/></mxCell><mxCell id="qa-54" value="&lt;b&gt;SRS section&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="770" width="140" height="30" as="geometry"/></mxCell><mxCell id="qa-55" value="&lt;b&gt;Effect on the design&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="770" width="460" height="30" as="geometry"/></mxCell><mxCell id="qa-56" value="A1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-57" value="A head-office branch record (e.g. HQ-00) exists, so every employee, including senior management and the regional director, is assigned to exactly one branch." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="800" width="880" height="46" as="geometry"/></mxCell><mxCell id="qa-58" value="7.1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="800" width="140" height="46" as="geometry"/></mxCell><mxCell id="qa-59" value="Keeps EMPLOYEE.BranchCode NOT NULL." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="800" width="460" height="46" as="geometry"/></mxCell><mxCell id="qa-60" value="A2" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="846" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-61" value="Surrogate numeric keys are used where the SRS gives none: TransferID, BlacklistID, JobNo, PaymentID, InvoiceNo, AccountNo, ReservationNo, RentalNo." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="846" width="880" height="46" as="geometry"/></mxCell><mxCell id="qa-62" value="7.6, 7.7, 7.15, 7.16" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="846" width="140" height="46" as="geometry"/></mxCell><mxCell id="qa-63" value="Simple single-column FKs." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="846" width="460" height="46" as="geometry"/></mxCell><mxCell id="qa-64" value="A3" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="892" width="60" height="30" as="geometry"/></mxCell><mxCell id="qa-65" value="VIN is the primary key of VEHICLE (PlateNumber is a second unique key). BranchCode (e.g. ALX-01) is the PK of BRANCH." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="892" width="880" height="30" as="geometry"/></mxCell><mxCell id="qa-66" value="7.1, 7.3" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="892" width="140" height="30" as="geometry"/></mxCell><mxCell id="qa-67" value="Natural keys given as unique by the SRS." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="892" width="460" height="30" as="geometry"/></mxCell><mxCell id="qa-68" value="A4" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="922" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-69" value="Pricing history is stored as dated rows (CATEGORY_RATE, VEHICLE_RATE, EXTRA_RATE). A NULL EndDate means the current open-ended rate. Old rows are never updated." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="922" width="880" height="46" as="geometry"/></mxCell><mxCell id="qa-70" value="7.3, 7.4" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="922" width="140" height="46" as="geometry"/></mxCell><mxCell id="qa-71" value="Satisfies 'old rates must never be overwritten'." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="922" width="460" height="46" as="geometry"/></mxCell><mxCell id="qa-72" value="A5" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="968" width="60" height="30" as="geometry"/></mxCell><mxCell id="qa-73" value="Enrollment attempts form a weak entity TRAINING_ATTEMPT identified by (Employee, Course, AttemptNo)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="968" width="880" height="30" as="geometry"/></mxCell><mxCell id="qa-74" value="7.2" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="968" width="140" height="30" as="geometry"/></mxCell><mxCell id="qa-75" value="Allows several attempts per employee per course." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="968" width="460" height="30" as="geometry"/></mxCell><mxCell id="qa-76" value="A6" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="998" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-77" value="Each customer has exactly one subtype (Individual or Corporate): total, disjoint specialization. Individuals have exactly one of National ID or Passport." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="998" width="880" height="46" as="geometry"/></mxCell><mxCell id="qa-78" value="7.7" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="998" width="140" height="46" as="geometry"/></mxCell><mxCell id="qa-79" value="CHECK on the subtype table plus BR-8." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="998" width="460" height="46" as="geometry"/></mxCell><mxCell id="qa-80" value="A7" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1044" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-81" value="Corporate driver = weak entity, PK (CorporateCustomerID, DriverNo); the rental references it with a composite FK that is NULL for individual customers." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="1044" width="880" height="46" as="geometry"/></mxCell><mxCell id="qa-82" value="7.7, 7.12" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="1044" width="140" height="46" as="geometry"/></mxCell><mxCell id="qa-83" value="Matches the 'Driver 1, Driver 2' numbering." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="1044" width="460" height="46" as="geometry"/></mxCell><mxCell id="qa-84" value="A8" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1090" width="60" height="30" as="geometry"/></mxCell><mxCell id="qa-85" value="Points balance, loyalty tier, rental days, employee age and invoice totals are derived. Only points movements are stored (POINTS_LOG)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="1090" width="880" height="30" as="geometry"/></mxCell><mxCell id="qa-86" value="7.1, 7.10" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="1090" width="140" height="30" as="geometry"/></mxCell><mxCell id="qa-87" value="Avoids update anomalies; views compute them." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="1090" width="460" height="30" as="geometry"/></mxCell><mxCell id="qa-88" value="A9" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1120" width="60" height="30" as="geometry"/></mxCell><mxCell id="qa-89" value="Additional drivers are a weak entity of RENTAL with their own license data and a daily fee, because the SRS only states the fee." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="1120" width="880" height="30" as="geometry"/></mxCell><mxCell id="qa-90" value="7.12" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="1120" width="140" height="30" as="geometry"/></mxCell><mxCell id="qa-91" value="Needed so a driver can be identified and charged." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="1120" width="460" height="30" as="geometry"/></mxCell><mxCell id="qa-92" value="A10" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1150" width="60" height="30" as="geometry"/></mxCell><mxCell id="qa-93" value="Feedback and the damage-report numbering (1, 2, 3 per rental) are weak entities of RENTAL; PK of FEEDBACK is the RentalNo itself." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="1150" width="880" height="30" as="geometry"/></mxCell><mxCell id="qa-94" value="7.14" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="1150" width="140" height="30" as="geometry"/></mxCell><mxCell id="qa-95" value="Gives one feedback per rental." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="1150" width="460" height="30" as="geometry"/></mxCell><mxCell id="qa-96" value="A11" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1180" width="60" height="30" as="geometry"/></mxCell><mxCell id="qa-97" value="A job card needs at least one mechanic in its worklog before it is closed (total participation of JOB_CARD in WORKS_ON)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="1180" width="880" height="30" as="geometry"/></mxCell><mxCell id="qa-98" value="7.15" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="1180" width="140" height="30" as="geometry"/></mxCell><mxCell id="qa-99" value="Enforced by the application/stored procedure." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="1180" width="460" height="30" as="geometry"/></mxCell><mxCell id="qa-100" value="A12" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1210" width="60" height="30" as="geometry"/></mxCell><mxCell id="qa-101" value="INVOICE is a new entity: one per corporate customer per month, with status Open/Paid/Overdue; rentals point to it with a nullable FK." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="1210" width="880" height="30" as="geometry"/></mxCell><mxCell id="qa-102" value="7.16" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="1210" width="140" height="30" as="geometry"/></mxCell><mxCell id="qa-103" value="Implements 'monthly consolidated invoice'." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="1210" width="460" height="30" as="geometry"/></mxCell><mxCell id="qa-104" value="A13" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1240" width="60" height="30" as="geometry"/></mxCell><mxCell id="qa-105" value="Transmission values are Manual/Automatic; money columns are DECIMAL(12,2); timestamps are DATETIME2; percentages are 0-100." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="1240" width="880" height="30" as="geometry"/></mxCell><mxCell id="qa-106" value="7.3" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="1240" width="140" height="30" as="geometry"/></mxCell><mxCell id="qa-107" value="Values not listed in the SRS." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="1240" width="460" height="30" as="geometry"/></mxCell><mxCell id="qa-108" value="A14" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1270" width="60" height="30" as="geometry"/></mxCell><mxCell id="qa-109" value="Pass/Fail and Score stay NULL until the attempt has a completion date." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="1270" width="880" height="30" as="geometry"/></mxCell><mxCell id="qa-110" value="7.2" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="1270" width="140" height="30" as="geometry"/></mxCell><mxCell id="qa-111" value="Table CHECK in TRAINING_ATTEMPT." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="1270" width="460" height="30" as="geometry"/></mxCell><mxCell id="qa-112" value="&lt;b&gt;Part C.3 - Contradictions and gaps found inside the SRS&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1350" width="1540" height="34" as="geometry"/></mxCell><mxCell id="qa-113" value="&lt;b&gt;#&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1390" width="60" height="30" as="geometry"/></mxCell><mxCell id="qa-114" value="&lt;b&gt;Contradiction / discrepancy&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="1390" width="940" height="30" as="geometry"/></mxCell><mxCell id="qa-115" value="&lt;b&gt;Sections&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="1390" width="120" height="30" as="geometry"/></mxCell><mxCell id="qa-116" value="&lt;b&gt;How it was resolved&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1180" y="1390" width="420" height="30" as="geometry"/></mxCell><mxCell id="qa-117" value="C1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1420" width="60" height="62" as="geometry"/></mxCell><mxCell id="qa-118" value="Branch manager: Sec. 7.1 says a branch is never left without a manager (total participation) but also that a regional director steps in temporarily, while one employee manages only one branch at a time. A regional director covering a branch would manage a second branch or a branch he does not work at." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="1420" width="940" height="62" as="geometry"/></mxCell><mxCell id="qa-119" value="7.1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="1420" width="120" height="62" as="geometry"/></mxCell><mxCell id="qa-120" value="Temporary cover is not stored as MANAGES; the manager must work at the branch and manage only it (BR-8)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1180" y="1420" width="420" height="62" as="geometry"/></mxCell><mxCell id="qa-121" value="C2" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1482" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-122" value="Employees: Sec. 7.1 says every employee is assigned to 1 branch, yet senior management 'reports to nobody' and the regional director covers branches, which suggests staff who belong to no single branch." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="1482" width="940" height="46" as="geometry"/></mxCell><mxCell id="qa-123" value="7.1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="1482" width="120" height="46" as="geometry"/></mxCell><mxCell id="qa-124" value="Resolved by assumption A1 (HQ branch row)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1180" y="1482" width="420" height="46" as="geometry"/></mxCell><mxCell id="qa-125" value="C3" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1528" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-126" value="Sec. 7.4 is titled 'Vehicle Equipment (Extras)' but its content describes extras charged per rental (child seats) with a rental quantity, not equipment attached to a vehicle." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="1528" width="940" height="46" as="geometry"/></mxCell><mxCell id="qa-127" value="7.4" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="1528" width="120" height="46" as="geometry"/></mxCell><mxCell id="qa-128" value="Modelled as rental add-ons: EXTRA, EXTRA_RATE, RENTAL_EXTRA." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1180" y="1528" width="420" height="46" as="geometry"/></mxCell><mxCell id="qa-129" value="C4" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1574" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-130" value="Objective O-1 demands 100% location accuracy of every vehicle at all times, but the data requirements contain no GPS positions, only a device serial number, SIM and install date, and branch-to-branch transfers." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="1574" width="940" height="46" as="geometry"/></mxCell><mxCell id="qa-131" value="5 vs 7.5, 7.6" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="1574" width="120" height="46" as="geometry"/></mxCell><mxCell id="qa-132" value="Out of scope / open question Q6." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1180" y="1574" width="420" height="46" as="geometry"/></mxCell><mxCell id="qa-133" value="C5" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1620" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-134" value="Sec. 7.8 is titled 'Corporate Contracts' but defines only category discounts; no contract (number, dates, signer) exists, although Sec. 6 and 4 talk about contracts and corporate billing." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="1620" width="940" height="46" as="geometry"/></mxCell><mxCell id="qa-135" value="7.8 vs 4, 6" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="1620" width="120" height="46" as="geometry"/></mxCell><mxCell id="qa-136" value="Discounts attach directly to the corporate customer (CONTRACT_DISCOUNT)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1180" y="1620" width="420" height="46" as="geometry"/></mxCell><mxCell id="qa-137" value="C6" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="1666" width="60" height="46" as="geometry"/></mxCell><mxCell id="qa-138" value="Sec. 7.5 allows a device in at most 1 vehicle, but Sec. 5 (O-3) wants a full audit trail. A vehicle's replaced GPS device cannot be tracked with one installation date per device." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="120" y="1666" width="940" height="46" as="geometry"/></mxCell><mxCell id="qa-139" value="7.5 vs 5" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="1666" width="120" height="46" as="geometry"/></mxCell><mxCell id="qa-140" value="Kept 1:1 as written; installation history is an extension." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1180" y="1666" width="420" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="br" name="4-Business-Rules"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1810" pageHeight="916" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="br-40" value="Omar Salem  |  Group: &amp;lt;GROUP&amp;gt;  |  Student ID: &amp;lt;STUDENT_ID&amp;gt;   |   Page: 4-Business-Rules" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="1400" height="30" as="geometry"/></mxCell><mxCell id="br-2" value="&lt;b&gt;Part D - Business rules that standard constraints cannot enforce&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="1650" height="34" as="geometry"/></mxCell><mxCell id="br-3" value="&lt;b&gt;ID&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="70" height="30" as="geometry"/></mxCell><mxCell id="br-4" value="&lt;b&gt;Business rule (SRS reference)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="130" y="160" width="420" height="30" as="geometry"/></mxCell><mxCell id="br-5" value="&lt;b&gt;Why PK / FK / NN / UQ / CK / DF are not enough&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="550" y="160" width="520" height="30" as="geometry"/></mxCell><mxCell id="br-6" value="&lt;b&gt;How to enforce it (trigger / stored procedure / application logic)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1070" y="160" width="640" height="30" as="geometry"/></mxCell><mxCell id="br-7" value="BR-1" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="70" height="62" as="geometry"/></mxCell><mxCell id="br-8" value="Blacklisted customers cannot book or rent (SRS 7.7)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="130" y="190" width="420" height="62" as="geometry"/></mxCell><mxCell id="br-9" value="A CHECK constraint sees only its own row, and an FK can only prove a row exists, not that another table has no matching active row. The test needs BLACKLIST_RECORD from RESERVATION/RENTAL inserts." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="550" y="190" width="520" height="62" as="geometry"/></mxCell><mxCell id="br-10" value="INSTEAD OF / AFTER INSERT trigger on RESERVATION and RENTAL: if EXISTS (SELECT 1 FROM BLACKLIST_RECORD WHERE CustomerID = inserted.CustomerID AND IsActive = 1) then ROLLBACK with THROW 50001. Also check in the booking stored procedure to give a friendly message." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1070" y="190" width="640" height="62" as="geometry"/></mxCell><mxCell id="br-11" value="BR-2" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="252" width="70" height="62" as="geometry"/></mxCell><mxCell id="br-12" value="A vehicle can only be rented when its status is Available, never twice for overlapping periods, and its status changes with the rental (SRS 7.3, 7.12)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="130" y="252" width="420" height="62" as="geometry"/></mxCell><mxCell id="br-13" value="Overlap of date ranges across rows of the same table and a status copy in VEHICLE (Rented/Available) are multi-row, multi-table rules; CK/UQ cannot express them." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="550" y="252" width="520" height="62" as="geometry"/></mxCell><mxCell id="br-14" value="Stored procedure usp_CreateRental (SERIALIZABLE, UPDLOCK on VEHICLE row): reject overlap with other open rentals/maintenance, set Status = 'Rented', and a trigger on RENTAL return sets it back to 'Available' and updates CurrentBranchCode and odometer." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1070" y="252" width="640" height="62" as="geometry"/></mxCell><mxCell id="br-15" value="BR-3" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="314" width="70" height="62" as="geometry"/></mxCell><mxCell id="br-16" value="Rate and discount periods of the same key must not overlap and the discount never exceeds 50% (SRS 7.3, 7.4, 7.8)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="130" y="314" width="420" height="62" as="geometry"/></mxCell><mxCell id="br-17" value="The 50% ceiling is a per-row CK, but non-overlap of (CategoryID, StartDate, EndDate) ranges needs a comparison against other rows (also VEHICLE_RATE, EXTRA_RATE, CONTRACT_DISCOUNT)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="550" y="314" width="520" height="62" as="geometry"/></mxCell><mxCell id="br-18" value="AFTER INSERT/UPDATE trigger (or exclusion check in the procedure that closes the previous period): reject when EXISTS another row of the same key whose [StartDate, EndDate] intersects the new one (NULL EndDate = infinity). Closing the old period is an UPDATE of EndDate only." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1070" y="314" width="640" height="62" as="geometry"/></mxCell><mxCell id="br-19" value="BR-4" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="376" width="70" height="62" as="geometry"/></mxCell><mxCell id="br-20" value="A promo code can be used only inside its validity period and while CurrentUses &lt; MaxUses; usage must be counted exactly once (SRS 7.9)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="130" y="376" width="420" height="62" as="geometry"/></mxCell><mxCell id="br-21" value="Validity compares RESERVATION.BookingTS (another table) with PROMO_CODE dates, and the counter must be incremented atomically under concurrent bookings." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="550" y="376" width="520" height="62" as="geometry"/></mxCell><mxCell id="br-22" value="usp_CreateReservation: UPDATE PROMO_CODE SET CurrentUses = CurrentUses + 1 WHERE PromoCode=@p AND SYSDATETIME() BETWEEN ValidFrom AND ValidTo AND CurrentUses &lt; MaxUses; if @@ROWCOUNT = 0 then reject. A trigger decrements it when the reservation is cancelled." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1070" y="376" width="640" height="62" as="geometry"/></mxCell><mxCell id="br-23" value="BR-5" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="438" width="70" height="46" as="geometry"/></mxCell><mxCell id="br-24" value="Corporate rentals may not exceed the approved credit limit (SRS 7.7, 7.16)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="130" y="438" width="420" height="46" as="geometry"/></mxCell><mxCell id="br-25" value="Needs a SUM over the customer's unpaid rentals, payments and invoices compared to CORPORATE_CUSTOMER.CreditLimit: aggregate across tables." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="550" y="438" width="520" height="46" as="geometry"/></mxCell><mxCell id="br-26" value="Trigger on RENTAL INSERT (and on PAYMENT) calling a function fn_OutstandingBalance(CustomerID); reject if balance + estimated charge &gt; CreditLimit. Reported to Finance by the monthly invoice job." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1070" y="438" width="640" height="46" as="geometry"/></mxCell><mxCell id="br-27" value="BR-6" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="484" width="70" height="78" as="geometry"/></mxCell><mxCell id="br-28" value="A rental extension must continue the previous rental: same customer and vehicle, pickup at the previous return time, previous rental not already extended, and the chain must not form a cycle (SRS 7.12)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="130" y="484" width="420" height="78" as="geometry"/></mxCell><mxCell id="br-29" value="UQ(PreviousRentalNo) and CK(PreviousRentalNo &lt;&gt; RentalNo) stop only the trivial cases; comparing columns of two different rows and detecting loops is beyond CK/FK." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="550" y="484" width="520" height="78" as="geometry"/></mxCell><mxCell id="br-30" value="AFTER INSERT trigger on RENTAL when PreviousRentalNo IS NOT NULL: join to the previous row, verify CustomerID, VIN, PickupTS = previous ExpectedReturnTS/ActualReturnTS, and walk the chain with a recursive CTE to reject cycles." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1070" y="484" width="640" height="78" as="geometry"/></mxCell><mxCell id="br-31" value="BR-7" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="562" width="70" height="46" as="geometry"/></mxCell><mxCell id="br-32" value="Redeemed points cannot exceed the balance, and the tier follows the balance: Silver &lt; 1000, Gold 1000-4999, Platinum &gt;= 5000 (SRS 7.10)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="130" y="562" width="420" height="46" as="geometry"/></mxCell><mxCell id="br-33" value="The balance is a SUM over many POINTS_LOG rows; CK cannot aggregate, and the tier is derived on purpose." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="550" y="562" width="520" height="46" as="geometry"/></mxCell><mxCell id="br-34" value="Trigger on POINTS_LOG INSERT: reject Redeemed rows when SUM(Points) + new Points &lt; 0. View vw_LoyaltyStatus computes balance and tier (CASE on the SUM)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1070" y="562" width="640" height="46" as="geometry"/></mxCell><mxCell id="br-35" value="BR-8" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="608" width="70" height="78" as="geometry"/></mxCell><mxCell id="br-36" value="Subtype integrity: an employee cannot be both RENTAL_AGENT and MECHANIC; every CUSTOMER has exactly one subtype row; a branch manager must work at the branch he manages and manage only that one (SRS 7.1, 7.7)." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="130" y="608" width="420" height="78" as="geometry"/></mxCell><mxCell id="br-37" value="Disjointness/totality spans two tables, and 'manager works at the managed branch' compares BRANCH.ManagerID with EMPLOYEE.BranchCode. Neither FK nor CK can check other tables." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="550" y="608" width="520" height="78" as="geometry"/></mxCell><mxCell id="br-38" value="Triggers on RENTAL_AGENT/MECHANIC (reject if the same EmployeeID exists in the other table), on INDIVIDUAL_/CORPORATE_CUSTOMER (reject if the id exists in the sibling), and on BRANCH (reject if EMPLOYEE.BranchCode &lt;&gt; BranchCode of the managed branch). Totality for CUSTOMER is checked by the usp_CreateCustomer procedure that inserts both rows in one transaction." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1070" y="608" width="640" height="78" as="geometry"/></mxCell><mxCell id="br-39" value="&lt;b&gt;Handled by plain constraints (so NOT listed above):&lt;/b&gt; source branch &amp;lt;&amp;gt; destination branch (CK on VEHICLE_TRANSFER), discount &amp;lt;= 50% per row (CK on CONTRACT_DISCOUNT), commission &amp;lt;= 15% (CK), employee age &amp;gt;= 21 at hire (CK), unique VIN/plate/SIM/transaction reference (UQ), one promo code per reservation (single FK column), one feedback per rental (PK = FK)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;strokeColor=#999999;fillColor=#f9f9f9;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="60" y="716" width="1650" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
